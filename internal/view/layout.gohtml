<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{.Title}}</title>
    <style>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            display: flex;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            font-size: 1.1rem;
            line-height: 1.7;
            color: #1a1a1a;
            background: #fafafa;
            padding: 0.5rem 1rem 1.5rem;
        }

        main {
            max-width: 80rem;
            margin: 0 auto;
            min-width: 0; /* flex item must shrink below its longest word */
            overflow-wrap: break-word;
        }

        h1, h2, h3, h4, h5, h6 {
            line-height: 1.3;
            margin-top: 1.5em;
            margin-bottom: 0.5em;
        }

        h1 { font-size: 1.9rem; }
        h2 { font-size: 1.5rem; }
        h3 { font-size: 1.25rem; }

        p, ul, ol, blockquote, pre, table {
            margin-bottom: 1.15em;
        }

        a {
            color: #1a6be0;
            text-decoration-thickness: 1px;
            text-underline-offset: 2px;
        }

        a:hover {
            color: #0f4da0;
        }

        img {
            max-width: 100%;
            height: auto;
            border-radius: 4px;
        }

        pre {
            background: #f0f0f0;
            padding: 1rem;
            overflow-x: auto;
            border-radius: 4px;
            font-size: 0.875rem;
            line-height: 1.5;
        }

        code {
            font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
            font-size: 0.875em;
        }

        :not(pre) > code {
            background: #f0f0f0;
            padding: 0.15em 0.35em;
            border-radius: 3px;
        }

        blockquote {
            border-left: 3px solid #ccc;
            padding-left: 1rem;
            color: #555;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            text-align: left;
            padding: 0.5rem 0.75rem;
            border-bottom: 1px solid #ddd;
        }

        th {
            font-weight: 600;
        }

        hr {
            border: none;
            border-top: 1px solid #ddd;
            margin: 2rem 0;
        }

        ul, ol {
            padding-left: 1.5em;
        }


        .nav-toggle { display: none; }
        .nav-overlay { display: none; }

        .nav-open-button {
            display: block;
            position: fixed;
            top: 0.5rem;
            left: 0.5rem;
            z-index: 11;
            width: 2.2rem;
            height: 2.2rem;
            line-height: 2.2rem;
            text-align: center;
            background: #242a35;
            border: 1px solid #242a35;
            border-radius: 6px;
            color: #e6ecf5;
            cursor: pointer;
            user-select: none;
            transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
        }

        /* sidebar hidden (desktop collapsed): the button floats on light content */
        .nav-toggle:checked ~ .nav-open-button {
            background: #fff;
            border-color: #ddd;
            color: #1a1a1a;
        }

        .sidebar {
            position: sticky;
            top: 0;
            align-self: flex-start;
            width: 13rem;
            flex-shrink: 0;
            min-height: 100vh;
            max-height: 100vh;
            overflow-y: auto;
            margin: -0.5rem 0 -1.5rem -1rem; /* cancel the body padding: flush left, full height */
            padding: 3.2rem 0.9rem 0.9rem; /* top clears the burger button */
            background: #242a35;
            overflow-wrap: anywhere;
        }

        .sidebar a {
            color: #9fb0c7;
        }

        .sidebar a:hover {
            color: #e6ecf5;
        }

        .sidebar .active {
            color: #fff;
        }

        .sidebar ul {
            list-style: none;
            padding-left: 0.9rem;
            margin: 0;
        }

        .sidebar > ul {
            padding-left: 0;
        }

        .sidebar li {
            margin: 0.15rem 0;
        }

        .sidebar .active {
            font-weight: 700;
        }

        /* the whole tree is rendered; only the current path stays visible */
        .sidebar ul ul {
            display: none;
        }

        .sidebar li:has(.active) > ul {
            display: block;
        }

        /* desktop: the toggle collapses the sidebar entirely */
        .nav-toggle:checked ~ .sidebar {
            display: none;
        }

        @media (max-width: 48rem) {
            .nav-open-button {
                background: #fff;
                border-color: #ddd;
                color: #1a1a1a;
            }

            /* when the drawer is open, the button melts into it */
            .nav-toggle:checked ~ .nav-open-button {
                background: #242a35;
                border-color: #242a35;
                color: #e6ecf5;
            }

            .sidebar {
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                z-index: 10;
                width: min(80vw, 18rem);
                height: 100vh;
                height: 100dvh;
                margin: 0;
                background: #242a35;
                padding-top: 3.2rem;
                transform: translateX(-100%);
                transition: transform 0.2s ease;
            }

            .nav-toggle:checked ~ .sidebar {
                display: block;
                transform: none;
                box-shadow: 0 0 20px rgba(0, 0, 0, 0.2);
            }

            .nav-toggle:checked ~ .nav-overlay {
                display: block;
                position: fixed;
                inset: 0;
                z-index: 9;
                background: rgba(0, 0, 0, 0.4);
                cursor: pointer;
            }
        }

    </style>
</head>
<body>
    {{if .Nav}}
    <input type="checkbox" id="nav-toggle" class="nav-toggle">
    <label for="nav-toggle" class="nav-open-button" aria-label="Toggle navigation">☰</label>
    <label for="nav-toggle" class="nav-overlay"></label>
    <nav class="sidebar">{{template "nav" .Nav}}</nav>
    {{end}}
    <main>
        {{if .ShowTitle}}
            <h1>{{.Title}}</h1>
        {{end}}
        {{.Content}}
    </main>
</body>
</html>

{{define "nav"}}
<ul class="nav-list">
    {{range .Children}}
    <li>
        <a href="{{.Link}}"{{if .Active}} class="active"{{end}}>{{or .Metadata.Title .Name}}</a>
        {{if .Children}}{{template "nav" .}}{{end}}
    </li>
    {{end}}
</ul>
{{end}}
